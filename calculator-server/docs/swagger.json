{
    "swagger": "2.0",
    "info": {
        "description": "REST microservice that performs basic and advanced arithmetic operations.",
        "title": "Calculator API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/health": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.HealthResponse"
                        }
                    }
                }
            }
        },
        "/operations": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "calculator"
                ],
                "summary": "List supported operations",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.OperationsResponse"
                        }
                    }
                }
            }
        },
        "/operations/{operation}": {
            "post": {
                "description": "Binary operations (add, subtract, multiply, divide, power, percentage) take two operands; sqrt takes one. percentage returns operands[1] percent of operands[0].",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "calculator"
                ],
                "summary": "Perform a calculation",
                "parameters": [
                    {
                        "enum": [
                            "add",
                            "subtract",
                            "multiply",
                            "divide",
                            "power",
                            "sqrt",
                            "percentage"
                        ],
                        "type": "string",
                        "description": "Operation name",
                        "name": "operation",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Operands",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.CalculationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.CalculationResponse"
                        }
                    },
                    "400": {
                        "description": "Malformed JSON or wrong operands",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Unknown operation",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "Mathematically invalid (e.g. division by zero)",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "httpapi.CalculationRequest": {
            "type": "object",
            "properties": {
                "operands": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    },
                    "example": [
                        12,
                        3
                    ]
                }
            }
        },
        "httpapi.CalculationResponse": {
            "type": "object",
            "properties": {
                "operands": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    },
                    "example": [
                        12,
                        3
                    ]
                },
                "operation": {
                    "type": "string",
                    "example": "divide"
                },
                "result": {
                    "type": "number",
                    "example": 4
                }
            }
        },
        "httpapi.ErrorDetail": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "DIVISION_BY_ZERO"
                },
                "message": {
                    "type": "string",
                    "example": "division by zero is not allowed"
                }
            }
        },
        "httpapi.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/httpapi.ErrorDetail"
                }
            }
        },
        "httpapi.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "httpapi.OperationResponse": {
            "type": "object",
            "properties": {
                "arity": {
                    "type": "integer",
                    "example": 2
                },
                "name": {
                    "type": "string",
                    "example": "add"
                }
            }
        },
        "httpapi.OperationsResponse": {
            "type": "object",
            "properties": {
                "operations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httpapi.OperationResponse"
                    }
                }
            }
        }
    }
}